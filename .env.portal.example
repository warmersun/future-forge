# Warmer Sun Cloud (portal) — copy to gitignored .env.portal
#   cp .env.portal.example .env.portal
#
# npm run portal loads .env.portal then .env.portal.local.
# It does not read .env (that's game: npm start).
# Portal is HTTP APIs + GET /signin (Clerk UI). Game sets FF_PORTAL_URL to this host
# (Render origin is fine for APIs). Public Sign in links use https://cloud.warmersun.com
# unless you set FF_PUBLIC_ORIGIN.
# Render: set the same keys in the Dashboard, not this file.

# Clerk (both required or Sign-in stays off)
# Dashboard: https://dashboard.clerk.com/~/api-keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Optional aliases: FF_CLERK_PUBLISHABLE_KEY / FF_CLERK_SECRET_KEY
# Comma-separated JWT azp origins. If set, this *replaces* the code defaults
# (127.0.0.1, localhost, https://warmersun.com, https://cloud.warmersun.com).
# Include every origin that holds a session JWT, including the portal Sign in host:
# CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8765,http://localhost:8765,https://warmersun.com,https://cloud.warmersun.com
# Public origin printed in device signInUrl (default https://cloud.warmersun.com):
# FF_PUBLIC_ORIGIN=https://cloud.warmersun.com
# Extra game SPA origins for device handshake CORS (comma-separated).
# Appends to loopback http://127.0.0.1:8765 and http://localhost:8765.
# Use the exact browser Origin (scheme + host, no path), e.g. a Tailscale Funnel URL:
# FF_GAME_DEVICE_ORIGINS=https://futureforge.xantu-chickadee.ts.net
# Svix signing secret for POST /api/webhooks/clerk
# Clerk Dashboard / `clerk env pull` may use CLERK_WEBHOOK_SIGNING_SECRET (same value).
# CLERK_WEBHOOK_SECRET=whsec_...

# Neon Postgres. Never commit the password.
# Runtime queries: pooler host + sslmode=require
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-XXXX-pooler.c-2.us-west-2.aws.neon.tech/neondb?sslmode=require
# Migrations on boot: unpooled if set
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-XXXX.c-2.us-west-2.aws.neon.tech/neondb?sslmode=require

# Render sets PORT and should set FF_TRUST_PROXY=1 (see render.yaml).
# Local portal: FF_PORT=8765
# FF_TRUST_PROXY=1

# Playwright click-through (scripts/clerk-signin-e2e.mjs) — local only:
# CLERK_E2E_EMAIL=you@example.com
# CLERK_E2E_PASSWORD=...
# CLERK_E2E_HEADED=1

# Hosted AI quota. Game (FF_CLOUD_AI=1) calls portal with the same FF_API_SECRET.
# No free tier: only plan slugs listed here may spend FF_XAI_API_KEY.
# FF_API_SECRET=
# FF_CLOUD_PLAN_SLUGS=cloud
# Included budget per subscription period, in whole points (same unit as FF_QUOTA_*).
# FF_CLOUD_AI_BUDGET=5000
# How much each modality counts, in whole points. Partial thousands and minutes round up.
# FF_USAGE_PRICE_* is the operator invoice estimate and is not this quota.
# FF_QUOTA_TEXT_IN_PER_KTOK=2
# FF_QUOTA_TEXT_OUT_PER_KTOK=6
# Text ceiling is input tokens plus this many output tokens, plus reasoning headroom (points).
# FF_QUOTA_TEXT_MAX_OUT=8192
# FF_QUOTA_TEXT_HOLD=20
# FF_QUOTA_IMAGE=20
# FF_QUOTA_TTS_PER_KCHAR=15
# FF_QUOTA_VOICE_PER_MIN=160
# Subscribe page origin (default https://cloud.warmersun.com):
# FF_PUBLIC_ORIGIN=https://cloud.warmersun.com

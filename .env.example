# Future Forge env vars — all use the FF_ prefix.
# Optional overrides only — SuperGrok login (grok login) is the default auth.
# FF_PORT=8765
# FF_HOST=0.0.0.0
# FF_XAI_MODEL=grok-4.6
# FF_XAI_API_KEY=xai-...
# FF_XAI_IMAGE_MODEL=grok-imagine-image
# FF_TTS_VOICE=eve
# FF_TTS_CACHE_DIR=./data/tts-cache
# FF_GROK_HOME=~/.grok
# FF_ENABLE_ROOMS=0
# FF_MAX_ROOMS=200
# FF_WS_MAX_PAYLOAD=262144
# FF_QUESTS_DIR=./quests
# FF_QUESTS_REMOTE_URL=https://warmersun.com/future-forge/quests/catalog.json
# FF_QUESTS_REMOTE_URL=off

# --- Hardening (recommended when exposing beyond loopback / LAN) ---
# Trust X-Forwarded-For only behind a reverse proxy you control:
# FF_TRUST_PROXY=1
# Optional shared secret for expensive POST routes (co-invent, vision, TTS, market-image).
# Loopback always allowed without the secret. Prefer X-FF-Secret (Authorization Bearer
# is used for Clerk session JWTs when learner accounts are on).
# FF_API_SECRET=
# Admin token for GET /api/usage and fat /api/health details from non-loopback peers:
# FF_ADMIN_TOKEN=

# --- Learner accounts (optional Clerk) ---
# Off unless both keys are set. Game stays fully playable unsigned.
# Hosted warmersun.com should set these; hobby self-host usually should not.
# Dashboard: https://dashboard.clerk.com/~/api-keys
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# Optional aliases: FF_CLERK_PUBLISHABLE_KEY / FF_CLERK_SECRET_KEY
# Comma-separated origins allowed in session JWTs (azp). Defaults:
#   http://127.0.0.1:8765, http://localhost:8765, https://warmersun.com
# CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8765,https://warmersun.com
# When Clerk + FF_API_SECRET are both on, send the instance secret as X-FF-Secret
# (Authorization Bearer is the Clerk session JWT).

# --- Warmer Sun Cloud DB (optional Neon Postgres) ---
# Gitignored in .env. Never commit the password.
# Long-running Node (server.mjs): use the *pooler* host + sslmode=require.
# Migrations / drizzle-kit: unpooled (no -pooler in the hostname).
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-XXXX-pooler.c-2.us-west-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ep-XXXX.c-2.us-west-2.aws.neon.tech/neondb?sslmode=require
# Optional rate-limit overrides (hits per minute unless noted):
# FF_RATE_CO_INVENT=40
# FF_RATE_VISION=20
# FF_RATE_TTS=30
# FF_RATE_AI_GLOBAL=80
# FF_RATE_WS_ACTION=40

# Developer UI (quest / trend inspect) — OFF by default. Prefer CLI: node server.mjs --developer
# Or enable here / in the environment:
# FF_DEVELOPER=1

# Live web + X search on timing assess and idea-sparks — OFF by default (slower).
# Prefer CLI: node server.mjs --ai-search
# FF_AI_SEARCH=1

# Usage metrics — OFF by default. Prefer CLI: node server.mjs --usage
# Or enable here / in the environment:
# FF_USAGE_ENABLED=1
# FF_USAGE_DIR=./data/usage
# FF_USAGE_FLUSH_MS=5000
# FF_USAGE_SESSION_IDLE_MS=1800000
# Optional unit prices for estimatedCostUsd in summary.json / GET /api/usage
# Source: https://docs.x.ai/developers/models (grok-4.6 + grok-imagine-image + TTS)
# grok-4.6 standard (< 200k prompt): $2 in / $6 out per 1M tokens
# FF_USAGE_PRICE_TEXT_IN_PER_MTOK=2.00
# FF_USAGE_PRICE_TEXT_OUT_PER_MTOK=6.00
# grok-imagine-image: $0.02 / image (use 0.05 for grok-imagine-image-quality)
# FF_USAGE_PRICE_IMAGE=0.02
# Text to Speech: $15.00 / 1M characters
# FF_USAGE_PRICE_TTS_PER_MCHAR=15.00

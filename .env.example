# Optional overrides only — SuperGrok login (grok login) is the default auth.
# PORT=8765
# XAI_MODEL=grok-4.5
# XAI_API_KEY=xai-...
# XAI_IMAGE_MODEL=grok-imagine-image

# Usage metrics — OFF by default. Prefer CLI: node server.mjs --usage
# Or enable here / in the environment:
# USAGE_ENABLED=1
# USAGE_DIR=./data/usage
# USAGE_FLUSH_MS=5000
# USAGE_SESSION_IDLE_MS=1800000
# Optional unit prices for estimatedCostUsd in summary.json / GET /api/usage
# USAGE_PRICE_TEXT_IN_PER_MTOK=1.00
# USAGE_PRICE_TEXT_OUT_PER_MTOK=3.00
# USAGE_PRICE_IMAGE=0.04

# game (`npm start`) — copy to gitignored .env
# portal (`npm run portal`) uses .env.portal — see .env.portal.example
#
# Two processes (do not bind both to the same port):
#   npm start        → game  (engine + SPA + xAI). Loads .env. HTTP :8765 only.
#   npm run portal   → portal (Cloud HTTP APIs + /signin). Loads .env.portal. No SPA, no xAI.
# Hosted Warmer Sun portal. Copy this file to .env and Sign in works as-is.
# FF_PORTAL_URL is the portal API origin — the Neon Function behind cloud.warmersun.com.
# Do NOT point it at https://warmersun.com/portal/ (the static UI proxies only selected routes,
# and here.now drops the Authorization header, so authenticated routes cannot go through it).
FF_PORTAL_URL=https://cloud.warmersun.com
# Browser destination for subscription links on quota errors. The Function needs the same
# value in its own environment; the game uses it only for links it renders.
FF_PORTAL_UI_URL=https://warmersun.com/portal/
# Accounts and the hosted quest catalog are separate opt-ins. Leave this off
# to keep your own Library and configured remote catalog when signing in.
# Set to 1 only to use the hosted catalog and its sign-in/subscription gates.
# FF_PORTAL_QUESTS=1
# A game served from a private IPv4 address (192.168.x, 10.x, 172.16-31.x) may
# sign in without extra configuration: those origins are accepted for CORS, the
# device handshake, and the same-tab return. Public HTTP hosts, link-local,
# CGNAT, IPv6 ULA and hostnames are never accepted. Set FF_ALLOW_LAN_ORIGINS=0
# on the portal Function to forbid private-LAN origins again.
# FF_ALLOW_LAN_ORIGINS=0
# FF_PORT=8765
# FF_HOST=0.0.0.0
#
# Play at http://127.0.0.1:8765 (or http://localhost:8765). Do not bind :443.
# Sign in: https://warmersun.com/portal/signin — the portal SPA mounts Clerk's own
# form and completes the one-time device code. The game chip opens that page (a
# popup, or the same tab when a popup is blocked) and polls a device JWT.
# Clerk is never loaded by the game on a non-hosted host.
# FF_XAI_MODEL=grok-4.7
# FF_XAI_API_KEY=xai-...
# FF_XAI_IMAGE_MODEL=grok-imagine-image
# FF_TTS_VOICE=eve
# FF_TTS_CACHE_DIR=./data/tts-cache
# FF_GROK_HOME=~/.grok
# FF_ENABLE_ROOMS=0
# FF_MAX_ROOMS=200
# FF_WS_MAX_PAYLOAD=262144
# FF_QUESTS_DIR=./quests
# Unpacked quest package served at /content/ (local lesson and asset root)
# FF_CONTENT_DIR=./unpacked-quest
# FF_QUESTS_REMOTE_URL=https://warmersun.com/quests/catalog.json
# FF_QUESTS_REMOTE_URL=off
# FF_TRENDS_REMOTE_URL=https://warmersun.com/trends/catalog.json
# FF_TRENDS_REMOTE_URL=off
# Predictions bank for the year dialog, outcome cards, and AI world clock (default: predictions/default.json)
# FF_PREDICTIONS_FILE=predictions/examples/musk-abundance.json
# FF_PREDICTIONS_FILE=https://example.com/my-predictions.json
# Public invent hop for Copy link / X posts (default heuristic: Funnel → warmersun.com/forge)
# FF_SHARE_ORIGIN=https://warmersun.com/forge
# Friends-room join URL (Funnel / MagicDNS). Lobby shows this; LAN IPs stay admin-only.
# FF_JOIN_ORIGIN=https://futureforge.xantu-chickadee.ts.net

# --- Hardening (recommended when exposing beyond loopback / LAN) ---
# Trust X-Forwarded-For only behind a reverse proxy you control.
# FF_TRUST_PROXY=1
# Optional shared secret for expensive POST routes (co-invent, vision, TTS, market-image).
# Loopback always allowed without the secret. Prefer X-FF-Secret (Authorization Bearer
# is used for Clerk session JWTs when learner accounts are on).
# FF_API_SECRET=
# Admin token for GET /api/usage and fat /api/health details from non-loopback peers:
# FF_ADMIN_TOKEN=

# Optional rate-limit overrides (hits per minute unless noted):
# FF_RATE_CO_INVENT=40
# FF_RATE_VISION=20
# FF_RATE_TTS=30
# FF_RATE_VOICE=8
# FF_RATE_AI_GLOBAL=80
# Concurrent Grok Voice calls (xAI team cap is 10). Duration cap in ms.
# FF_VOICE_MAX_SESSIONS=8
# FF_VOICE_MAX_MS=600000
# Quiet stretch with no audio frames (a backgrounded tab). Open-mic silence still counts as audio.
# FF_VOICE_IDLE_MS=90000
# FF_RATE_WS_ACTION=40

# Developer UI (quest / trend inspect) — OFF by default. Prefer CLI: node server.mjs --developer
# Or enable here / in the environment:
# FF_DEVELOPER=1

# Live web + X search on timing assess and idea-sparks — OFF by default (slower).
# Prefer CLI: node server.mjs --ai-search
# FF_AI_SEARCH=1

# Usage metrics — OFF by default. Prefer CLI: node server.mjs --usage
# Or enable here / in the environment:
# FF_USAGE_ENABLED=1
# FF_USAGE_DIR=./data/usage
# FF_USAGE_FLUSH_MS=5000
# FF_USAGE_SESSION_IDLE_MS=1800000
# Optional unit prices for estimatedCostUsd in summary.json / GET /api/usage
# Source: https://docs.x.ai/developers/models (grok-4.7 + grok-imagine-image + TTS)
# grok-4.7 standard (< 200k prompt): $2 in / $6 out per 1M tokens
# FF_USAGE_PRICE_TEXT_IN_PER_MTOK=2.00
# FF_USAGE_PRICE_TEXT_OUT_PER_MTOK=6.00
# grok-imagine-image: $0.02 / image (use 0.05 for grok-imagine-image-quality)
# FF_USAGE_PRICE_IMAGE=0.02
# Text to Speech: $15.00 / 1M characters
# FF_USAGE_PRICE_TTS_PER_MCHAR=15.00
# Grok Voice Speech-to-Speech: $0.08 / min of audio sent or received
# FF_USAGE_PRICE_VOICE_PER_MIN=0.08

# Hosted Cloud AI (the process that spends FF_XAI_API_KEY for subscribers).
# Off for self-host. On for the public game: quota is checked at FF_PORTAL_URL before xAI.
# FF_CLOUD_AI=1
# FF_PORTAL_URL is already set above (cloud.warmersun.com); the same value goes on this process.
# FF_API_SECRET= shared with portal (X-FF-Secret on quota reserve/settle)
